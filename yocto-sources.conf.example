# Copy to yocto-sources.conf in this repository (gitignored).

YOCTO_BRANCH="wrynose"

OECORE_REPO="https://github.com/openembedded/openembedded-core.git"
OECORE_BRANCH="${YOCTO_BRANCH}"

BITBAKE_REPO="https://github.com/openembedded/bitbake.git"
# BITBAKE_BRANCH="2.18"   # derived from YOCTO_BRANCH when unset

META_YOCTO_REPO="https://github.com/yoctoproject/meta-yocto.git"
META_YOCTO_BRANCH="${YOCTO_BRANCH}"

OE_REPO="https://github.com/openembedded/meta-openembedded.git"
OE_BRANCH="${YOCTO_BRANCH}"

QT_REPO="https://github.com/meta-qt5/meta-qt5.git"
QT_BRANCH="${YOCTO_BRANCH}"

# Yocto download & build directory (default: ../yocto next to this repo)
# OPENTINA_YOCTO_DIR="/path/to/yocto-workspace"
