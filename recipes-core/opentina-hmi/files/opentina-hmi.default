# Environment for the OpenTina HMI services.

# The imagination Vulkan driver is not Vulkan-conformant yet and refuses to
# load without this opt-in.
PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1

# Command started by opentina-kiosk.service. The default renders a rotating
# cube through the Vulkan driver, so a working screen also proves the whole
# GPU path. Replace it with the product application; no unit change needed.
OPENTINA_KIOSK_CMD=/usr/bin/vkcube

# Uncomment to force software rendering, e.g. to compare against llvmpipe.
#LIBGL_ALWAYS_SOFTWARE=1
#GALLIUM_DRIVER=llvmpipe
